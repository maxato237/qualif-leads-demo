# Clé API Mistral : https://console.mistral.ai (offre gratuite "Experiment")
MISTRAL_API_KEY=
LLM_MODEL=ministral-14b-latest

# Domaine du front autorisé (CORS)
FRONTEND_ORIGIN=http://localhost:4200

# Protection du budget
RATE_LIMIT_LEADS=10 per hour;3 per minute
DAILY_QUOTA=100

# Google Sheet de démo (laisser vide pour désactiver)
# Clé JSON du compte de service, brute ou encodée en base64 (base64 -w0 cle.json)
GOOGLE_SERVICE_ACCOUNT=
# Identifiant dans l'URL : docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
SHEET_RANGE=Leads!A:L

# Email à l'agence fictive (laisser vide pour désactiver). Exemple avec Brevo :
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur validé chez le fournisseur SMTP
MAIL_FROM=
# Boîte de démo qui reçoit les leads : fixe, jamais choisie par le visiteur
MAIL_TO=
